<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.games-site.auto-build-site</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/zhaoq0103/DEV/Personal/How-to-Make-Money/games-site/auto-build-site.sh</string>
    </array>

    <!--
      每天运行 2 次（2026-10-26 起调整为美国上午 + 下午各一轮）：

      🌅 21:00 (北京时间) = 纽约 09:00 (夏令时) / 08:00 (冬令时)  → 美国上午
      🌇 04:00 (北京时间) = 纽约 16:00 (夏令时) / 15:00 (冬令时)  → 美国下午

      为什么能用固定北京时刻覆盖两个季节：夏令时/冬令时相差 1 小时，而目标窗口本身
      放宽到「美国上午 8–9 点、下午 3–4 点」，所以 21:00 / 04:00 两个本机时刻，
      全年都落在窗口内（各季各差 1 小时，恰好被窗口宽度吃掉），不需要 launchd 传 TZ
      （StartCalendarInterval 只认本机时区，无法按 job 设 TZ）。

      同时避开 DeepSeek 高峰期（工作日北京 09:00–12:00、14:00–18:00）。

      变更记录：
      - 2026-10-26: 每天 1 次（05:00）→ 每天 2 次（04:00 + 21:00），用户要求「美国上午 8–9 点、
        下午 3–4 点各跑一轮」，不追求精确卡点
      - 2026-09-02: 07:07 → 05:00（改打美国下班时段）
      - 2026-08-24: 每天 2 次（07:07 + 22:07）→ 每天 1 次（07:07）
    -->

    <key>StartCalendarInterval</key>
    <array>
        <!-- 每天 04:00 (北京时间) = 美国下午 15:00 / 16:00 -->
        <dict>
            <key>Hour</key>
            <integer>4</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 每天 21:00 (北京时间) = 美国上午 08:00 / 09:00 -->
        <dict>
            <key>Hour</key>
            <integer>21</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- 日志 -->
    <key>StandardOutPath</key>
    <string>/Users/zhaoq0103/Library/Logs/auto-build-site/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zhaoq0103/Library/Logs/auto-build-site/stderr.log</string>

    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/zhaoq0103</string>
        <key>PATH</key>
        <string>/Users/zhaoq0103/.local/bin:/Users/zhaoq0103/.nvm/versions/node/v24.4.0/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
