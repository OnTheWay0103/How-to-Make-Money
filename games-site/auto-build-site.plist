<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.games-site.auto-build-site</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/zhaoq0103/DEV/Personal/How-to-Make-Money/games-site/auto-build-site.sh</string>
    </array>

    <!--
      每天运行一次（2026-08-24 起调整为每天 1 次）：

      🌅 每天 05:00 (北京时间) = 纽约 17:00 (夏令时) / 16:00 (冬令时)
         建站时刻全年落在美国下班前后（下午 4-5 点），覆盖「下班后打游戏」时段

      变更记录：
      - 2026-09-02: 07:07 → 05:00（改打美国下班时段；04:30 在冬令时会落到 15:30 偏早，故取 05:00）
      - 2026-08-24: 每天 2 次（07:07 + 22:07）→ 每天 1 次（07:07）
      原因：AdSense 合规改造后以稳为主，每天最多新增 1 个站点
    -->

    <key>StartCalendarInterval</key>
    <array>
        <!-- 每天 05:00 (北京时间) -->
        <dict>
            <key>Hour</key>
            <integer>5</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- 日志 -->
    <key>StandardOutPath</key>
    <string>/Users/zhaoq0103/Library/Logs/auto-build-site/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zhaoq0103/Library/Logs/auto-build-site/stderr.log</string>

    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/zhaoq0103</string>
        <key>PATH</key>
        <string>/Users/zhaoq0103/.local/bin:/Users/zhaoq0103/.nvm/versions/node/v24.4.0/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
